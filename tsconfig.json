{
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "noEmitOnError": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    // "jsxImportSource": "preact",
    "declaration": true,
    "removeComments": false,
    "esModuleInterop": true,
    "strict": true,
    "allowJs": true,
    "preserveConstEnums": true,
    "incremental": true,
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo", // must be inside dist: build.pre.js cleans dist to force re-emit
    "newLine": "lf",
  },
  "files": ["src/index.ts"],
  "include": ["src/**/*"],
  "exclude": ["node_modules", "build", ".vscode", "lib", "dist", "icomoon", "src/**/*.example.*"]
}
