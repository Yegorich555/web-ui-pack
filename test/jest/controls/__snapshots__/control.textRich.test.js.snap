  :root {
  --modal-anim-t: 400ms;
}
  :root {
  --popup-anim-t: 300ms;
  --popup-text: inherit;
  --popup-bg: #fff;
  --popup-shadow: #0003;
  --tooltip-text: inherit;
  --tooltip-bg: rgba(255, 255, 255, 0.9);
  --tooltip-shadow: #0003;
}
[wupdark] {
  --popup-text: #d8d8d8;
  --popup-bg: #2b3645;
  --popup-shadow: #0006;
  --tooltip-text: #d8d8d8;
  --tooltip-bg: rgba(16, 70, 82, 0.9);
  --tooltip-shadow: #0006;
}
  
WUP-POPUP {
  --modal-anim: var(--modal-anim-t) cubic-bezier(0, 0, 0.2, 1) 0ms;
  z-index: 8000;
  display: none;
  opacity: 0;
  position: fixed !important;
  border-radius: var(--border-radius);
  padding: var(--base-margin);
  box-sizing: border-box;
  white-space: pre-line;
  overflow: auto;
  overflow: overlay;
}
WUP-POPUP[open] {
  display: block;
}
WUP-POPUP[show] {
  opacity: 1;
}
WUP-POPUP::-webkit-scrollbar {
  width: 10px;
  height: 10px;
  cursor: pointer;
}
WUP-POPUP::-webkit-scrollbar-corner {
  background: none;
  cursor: pointer;
}
WUP-POPUP::-webkit-scrollbar-thumb {
  border: 3px solid rgba(0, 0, 0, 0);
  background-clip: padding-box;
  background-color: var(--scroll, rgba(0, 0, 0, 0.2));
  border-radius: 999px;
  cursor: pointer;
}
@media (hover: hover) {
WUP-POPUP::-webkit-scrollbar-thumb:hover {
  background-color: var(--scroll-hover, rgba(0, 0, 0, 0.5));
  cursor: pointer;
}
}
WUP-POPUP::-webkit-scrollbar-track-piece:vertical:start, WUP-POPUP::-webkit-scrollbar-track-piece:vertical:end, WUP-POPUP::-webkit-scrollbar-track-piece:horizontal:start, WUP-POPUP::-webkit-scrollbar-track-piece:horizontal:end {
  margin: 0;
  cursor: pointer;
}
@media not all and (prefers-reduced-motion) {
