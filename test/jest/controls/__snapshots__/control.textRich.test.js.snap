}
[wupdark] {
  --ctrl-textrich-quote: #555;
  --ctrl-textrich-code-bg: #1d1d1d;
  --ctrl-textrich-btn-focus: rgba(255, 255, 255, 0.12);
}
  
WUP-TEXTRICH {
  --ctrl-focus-border: var(--ctrl-focus);
  contain: style;
  display: block;
  flex: 1;
  margin: var(--base-margin) 0;
  box-shadow: 0 0 0 1px var(--ctrl-border);
  border-radius: var(--ctrl-border-radius);
  color: var(--ctrl-text);
  background: var(--ctrl-bg);
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
}
WUP-TEXTRICH strong,
WUP-TEXTRICH legend {
  color: var(--ctrl-label);
  pointer-events: none;
}
WUP-TEXTRICH[invalid], WUP-TEXTRICH[invalid] &gt; [menu] {
  --ctrl-focus-border: var(--ctrl-invalid-border);
  box-shadow: 0 0 3px 0 var(--ctrl-focus-border);
}
WUP-TEXTRICH:focus-within, WUP-TEXTRICH:focus-within &gt; [menu] {
  box-shadow: 0 0 2px 1px var(--ctrl-focus-border);
}
WUP-TEXTRICH:focus-within strong,
WUP-TEXTRICH:focus-within legend {
  color: var(--ctrl-focus-label);
  pointer-events: initial;
}
[disabled] WUP-TEXTRICH, WUP-TEXTRICH[disabled] {
  opacity: 0.6;
  cursor: not-allowed;
  -webkit-user-select: none;
          user-select: none;
}
WUP-TEXTRICH[busy] {
  opacity: 0.8;
  cursor: inherit;
  -webkit-user-select: none;
          user-select: none;
}
[disabled] WUP-TEXTRICH &gt; label, WUP-TEXTRICH[disabled] &gt; label, WUP-TEXTRICH[busy] &gt; label {
  pointer-events: none;
}
WUP-TEXTRICH label {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  font: inherit;
  cursor: inherit;
  padding: var(--ctrl-padding);
  padding-top: 0;
  padding-bottom: 0;
}
WUP-TEXTRICH input,
WUP-TEXTRICH textarea {
  padding: 0;
  margin: 0;
  cursor: inherit;
}
WUP-TEXTRICH [contenteditable=true] {
  margin: var(--ctrl-padding);
  margin-left: 0;
  margin-right: 0;
  cursor: inherit;
}
WUP-TEXTRICH strong {
  cursor: inherit;
}
WUP-TEXTRICH strong:empty {
  display: none;
}
WUP-TEXTRICH [aria-required=true] + strong:after,
WUP-TEXTRICH fieldset[aria-required=true] &gt; legend:after {
  content: "*";
  font-size: larger;
  font-weight: bolder;
  line-height: 0;
}
WUP-TEXTRICH [error] {
  cursor: pointer;
  font-size: small;
  color: var(--ctrl-err);
  background: var(--ctrl-err-bg);
  overflow: auto;
  overflow: overlay;
}
WUP-TEXTRICH [error] ul {
  margin: 0;
  padding: 2px 4px 2px;
}
WUP-TEXTRICH [error] li {
  display: flex;
  align-items: center;
  margin-left: -5px;
}
WUP-TEXTRICH [error] li:before {
  content: "";
  --ctrl-icon-img: var(--wup-icon-dot);
  --ctrl-icon: var(--ctrl-err);
  display: inline-block;
  width: var(--ctrl-icon-size);
  min-height: var(--ctrl-icon-size);
  box-sizing: content-box;
  margin: 0;
  padding: 5px;
  flex: 0 0 auto;
  align-self: stretch;
  border: none;
  box-shadow: none;
  background: var(--ctrl-icon);
  -webkit-mask-size: var(--ctrl-icon-size);
          mask-size: var(--ctrl-icon-size);
  -webkit-mask-repeat: no-repeat;
          mask-repeat: no-repeat;
  -webkit-mask-position: center;
          mask-position: center;
  -webkit-mask-image: var(--ctrl-icon-img);
          mask-image: var(--ctrl-icon-img);
}
WUP-TEXTRICH [error] li[valid] {
  color: var(--ctrl-err-valid);
}
WUP-TEXTRICH [error] li[valid]:before {
  content: "";
  --ctrl-icon-img: var(--wup-icon-check);
  --ctrl-icon: var(--ctrl-err-valid);
}
WUP-TEXTRICH:focus-within [error] {
  max-height: none;
}
@media (hover: hover) and (pointer: fine) {
  WUP-TEXTRICH:hover strong, WUP-TEXTRICH[hovered] strong {
    color: var(--ctrl-focus-label);
  }
  WUP-TEXTRICH:hover, WUP-TEXTRICH:hover &gt; [menu], WUP-TEXTRICH[hovered], WUP-TEXTRICH[hovered] &gt; [menu] {
    box-shadow: 0 0 2px 1px var(--ctrl-focus-border);
  }
}
@media not all and (prefers-reduced-motion) {
  WUP-TEXTRICH {
    transition: box-shadow var(--anim);
  }
}
WUP-TEXTRICH {
  cursor: text;
  text-align: start;
}
WUP-TEXTRICH label &gt; span {
  width: 100%;
  position: relative;
  display: flex;
  flex-direction: row-reverse;
}
WUP-TEXTRICH input,
WUP-TEXTRICH textarea,
WUP-TEXTRICH [maskholder],
WUP-TEXTRICH [prefix],
WUP-TEXTRICH [postfix] {
  padding: var(--ctrl-padding);
  padding-left: 0;
  padding-right: 0;
  font: inherit;
  text-align: inherit;
  color: inherit;
  margin: 0;
  text-overflow: ellipsis;
  overflow: hidden;
  white-space: nowrap;
}
WUP-TEXTRICH input,
WUP-TEXTRICH textarea,
WUP-TEXTRICH [contenteditable=true],
WUP-TEXTRICH [maskholder],
WUP-TEXTRICH [postfix] {
  width: 100%;
  box-sizing: border-box;
  border: none;
  background: none;
  outline: none;
}
WUP-TEXTRICH [prefix],
WUP-TEXTRICH [postfix] {
  color: inherit;
  flex-shrink: 0;
}
WUP-TEXTRICH [maskholder],
WUP-TEXTRICH [prefix],
WUP-TEXTRICH [postfix] {
  display: none;
  opacity: 0;
  pointer-events: none;
  text-overflow: initial;
  white-space: pre;
}
