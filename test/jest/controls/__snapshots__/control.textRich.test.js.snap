[wupdark] {
  --ctrl-textrich-quote: #555;
  --ctrl-textrich-code-bg: #1d1d1d;
}
[wup-textrich] blockquote {
  margin: 5px 0;
  padding-left: 16px;
  border-left: 4px solid var(--ctrl-textrich-quote);
}
[wup-textrich] pre {
  margin: 5px 0;
  padding: 5px 10px;
  border-radius: 3px;
  background: var(--ctrl-textrich-code-bg);
  font-family: monospace;
  white-space: pre-wrap;
}
  
WUP-TEXTRICH {
  --ctrl-focus-border: var(--ctrl-focus);
  contain: style;
  display: block;
  flex: 1;
  margin: var(--base-margin) 0;
  box-shadow: 0 0 0 1px var(--ctrl-border);
  border-radius: var(--ctrl-border-radius);
  color: var(--ctrl-text);
  background: var(--ctrl-bg);
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
}
WUP-TEXTRICH strong,
WUP-TEXTRICH legend {
  color: var(--ctrl-label);
  pointer-events: none;
}
WUP-TEXTRICH[invalid], WUP-TEXTRICH[invalid] &gt; [menu] {
  --ctrl-focus-border: var(--ctrl-invalid-border);
  box-shadow: 0 0 3px 0 var(--ctrl-focus-border);
}
WUP-TEXTRICH:focus-within, WUP-TEXTRICH:focus-within &gt; [menu] {
  box-shadow: 0 0 2px 1px var(--ctrl-focus-border);
}
WUP-TEXTRICH:focus-within strong,
WUP-TEXTRICH:focus-within legend {
  color: var(--ctrl-focus-label);
  pointer-events: initial;
}
[disabled] WUP-TEXTRICH, WUP-TEXTRICH[disabled] {
  opacity: 0.6;
  cursor: not-allowed;
  -webkit-user-select: none;
          user-select: none;
}
WUP-TEXTRICH[busy] {
  opacity: 0.8;
  cursor: inherit;
  -webkit-user-select: none;
          user-select: none;
}
[disabled] WUP-TEXTRICH &gt; label, WUP-TEXTRICH[disabled] &gt; label, WUP-TEXTRICH[busy] &gt; label {
  pointer-events: none;
}
WUP-TEXTRICH label {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  font: inherit;
  cursor: inherit;
  padding: var(--ctrl-padding);
  padding-top: 0;
  padding-bottom: 0;
}
WUP-TEXTRICH input,
WUP-TEXTRICH textarea {
  padding: 0;
  margin: 0;
  cursor: inherit;
}
WUP-TEXTRICH [contenteditable=true] {
  margin: var(--ctrl-padding);
  margin-left: 0;
  margin-right: 0;
  cursor: inherit;
}
WUP-TEXTRICH strong {
  cursor: inherit;
}
WUP-TEXTRICH strong:empty {
  display: none;
}
WUP-TEXTRICH [aria-required=true] + strong:after,
WUP-TEXTRICH fieldset[aria-required=true] &gt; legend:after {
  content: "*";
  font-size: larger;
  font-weight: bolder;
  line-height: 0;
}
WUP-TEXTRICH [error] {
  cursor: pointer;
  font-size: small;
  color: var(--ctrl-err);
  background: var(--ctrl-err-bg);
  overflow: auto;
  overflow: overlay;
}
WUP-TEXTRICH [error] ul {
  margin: 0;
  padding: 2px 4px 2px;
}
WUP-TEXTRICH [error] li {
  display: flex;
  align-items: center;
  margin-left: -5px;
}
WUP-TEXTRICH [error] li:before {
  content: "";
  --ctrl-icon-img: var(--wup-icon-dot);
  --ctrl-icon: var(--ctrl-err);
  display: inline-block;
  width: var(--ctrl-icon-size);
  min-height: var(--ctrl-icon-size);
  box-sizing: content-box;
  margin: 0;
  padding: 5px;
  flex: 0 0 auto;
  align-self: stretch;
  border: none;
  box-shadow: none;
  background: var(--ctrl-icon);
  -webkit-mask-size: var(--ctrl-icon-size);
          mask-size: var(--ctrl-icon-size);
  -webkit-mask-repeat: no-repeat;
          mask-repeat: no-repeat;
  -webkit-mask-position: center;
          mask-position: center;
  -webkit-mask-image: var(--ctrl-icon-img);
          mask-image: var(--ctrl-icon-img);
}
WUP-TEXTRICH [error] li[valid] {
  color: var(--ctrl-err-valid);
}
WUP-TEXTRICH [error] li[valid]:before {
  content: "";
  --ctrl-icon-img: var(--wup-icon-check);
  --ctrl-icon: var(--ctrl-err-valid);
}
WUP-TEXTRICH:focus-within [error] {
  max-height: none;
}
@media (hover: hover) and (pointer: fine) {
  WUP-TEXTRICH:hover strong, WUP-TEXTRICH[hovered] strong {
    color: var(--ctrl-focus-label);
  }
  WUP-TEXTRICH:hover, WUP-TEXTRICH:hover &gt; [menu], WUP-TEXTRICH[hovered], WUP-TEXTRICH[hovered] &gt; [menu] {
    box-shadow: 0 0 2px 1px var(--ctrl-focus-border);
  }
}
@media not all and (prefers-reduced-motion) {
  WUP-TEXTRICH {
    transition: box-shadow var(--anim);
  }
}
WUP-TEXTRICH {
  cursor: text;
  text-align: start;
}
WUP-TEXTRICH label &gt; span {
  width: 100%;
  position: relative;
  display: flex;
  flex-direction: row-reverse;
}
WUP-TEXTRICH input,
WUP-TEXTRICH textarea,
WUP-TEXTRICH [maskholder],
WUP-TEXTRICH [prefix],
WUP-TEXTRICH [postfix] {
  padding: var(--ctrl-padding);
  padding-left: 0;
  padding-right: 0;
  font: inherit;
  text-align: inherit;
  color: inherit;
  margin: 0;
  text-overflow: ellipsis;
  overflow: hidden;
  white-space: nowrap;
}
WUP-TEXTRICH input,
WUP-TEXTRICH textarea,
WUP-TEXTRICH [contenteditable=true],
WUP-TEXTRICH [maskholder],
WUP-TEXTRICH [postfix] {
  width: 100%;
  box-sizing: border-box;
  border: none;
  background: none;
  outline: none;
}
WUP-TEXTRICH [prefix],
WUP-TEXTRICH [postfix] {
  color: inherit;
  flex-shrink: 0;
}
WUP-TEXTRICH [maskholder],
WUP-TEXTRICH [prefix],
WUP-TEXTRICH [postfix] {
  display: none;
  opacity: 0;
  pointer-events: none;
  text-overflow: initial;
  white-space: pre;
}
WUP-TEXTRICH [postfix] {
  position: absolute;
}
WUP-TEXTRICH [maskholder] {
  position: absolute;
  opacity: 0.65;
}
WUP-TEXTRICH [maskholder] &gt; i,
WUP-TEXTRICH [postfix] &gt; i {
  visibility: hidden;
  font: inherit;
  white-space: pre;
}
WUP-TEXTRICH input:-webkit-autofill, WUP-TEXTRICH textarea:-webkit-autofill, WUP-TEXTRICH [contenteditable=true]:-webkit-autofill {
  font: inherit;
  background-clip: text;
  -webkit-text-fill-color: var(--ctrl-autofill);
  caret-color: var(--ctrl-autofill-caret, auto);
}
WUP-TEXTRICH input:autofill,
WUP-TEXTRICH textarea:autofill,
WUP-TEXTRICH [contenteditable=true]:autofill {
  font: inherit;
  background-clip: text;
  -webkit-text-fill-color: var(--ctrl-autofill);
  caret-color: var(--ctrl-autofill-caret, auto);
}
WUP-TEXTRICH strong {
  display: block;
  position: absolute;
  top: 50%;
  left: 0;
  padding: 0;
  margin: 0;
  box-sizing: border-box;
  max-width: 100%;
  text-overflow: ellipsis;
  overflow: hidden;
  white-space: nowrap;
  transform-origin: top left;
  transform: translateY(-50%);
  font-weight: normal;
  text-decoration: none;
  -webkit-backface-visibility: hidden;
          backface-visibility: hidden;
}
@media not all and (prefers-reduced-motion) {
  WUP-TEXTRICH strong {
    transition: top var(--anim), transform var(--anim), color var(--anim);
  }
}
WUP-TEXTRICH input:not(:focus)::placeholder,
WUP-TEXTRICH textarea:not(:focus)::placeholder {
  color: transparent;
}
WUP-TEXTRICH:focus-within strong,
WUP-TEXTRICH input:not(:placeholder-shown) + strong,
WUP-TEXTRICH textarea:not(:placeholder-shown) + strong,
WUP-TEXTRICH [contenteditable=true]:not(:empty) + strong,
WUP-TEXTRICH legend {
  transform: var(--ctrl-label-active-pos);
}
WUP-TEXTRICH input:-webkit-autofill + strong, WUP-TEXTRICH textarea:-webkit-autofill + strong, WUP-TEXTRICH [contenteditable=true]:-webkit-autofill + strong {
  transform: var(--ctrl-label-active-pos);
}
WUP-TEXTRICH input:autofill + strong,
WUP-TEXTRICH textarea:autofill + strong,
WUP-TEXTRICH [contenteditable=true]:autofill + strong {
  transform: var(--ctrl-label-active-pos);
}
WUP-TEXTRICH:focus-within [maskholder], WUP-TEXTRICH:focus-within [prefix], WUP-TEXTRICH:focus-within [postfix],
WUP-TEXTRICH input:not(:placeholder-shown) ~ [prefix],
WUP-TEXTRICH input:not(:placeholder-shown) ~ [postfix],
WUP-TEXTRICH textarea:not(:placeholder-shown) ~ [prefix],
WUP-TEXTRICH textarea:not(:placeholder-shown) ~ [postfix] {
  display: inline-block;
  opacity: 1;
}
WUP-TEXTRICH label:after,
WUP-TEXTRICH label:before {
  display: inline-block;
  width: var(--ctrl-icon-size);
  min-height: var(--ctrl-icon-size);
  box-sizing: content-box;
  margin: 0;
  padding: 5px;
  flex: 0 0 auto;
  align-self: stretch;
  border: none;
  box-shadow: none;
  background: var(--ctrl-icon);
  -webkit-mask-size: var(--ctrl-icon-size);
          mask-size: var(--ctrl-icon-size);
  -webkit-mask-repeat: no-repeat;
          mask-repeat: no-repeat;
  -webkit-mask-position: center;
          mask-position: center;
  -webkit-mask-image: var(--ctrl-icon-img);
          mask-image: var(--ctrl-icon-img);
  cursor: pointer;
  -webkit-mask-image: none;
          mask-image: none;
}
WUP-TEXTRICH label:after {
  margin-right: calc(var(--ctrl-icon-size) / -2);
}
WUP-TEXTRICH label:before {
  margin-left: calc(var(--ctrl-icon-size) / -2);
}
WUP-TEXTRICH label &gt; button {
  z-index: 1;
  contain: strict;
  font-size: inherit;
  flex: 0 0 auto;
  align-self: center;
}
WUP-TEXTRICH button[clear] {
  --icon-size: var(--ctrl-icon-size);
  --icon-hover-r: 24px;
  --icon-img: var(--wup-icon-cross);
  --icon: var(--ctrl-label);
  --icon-hover: var(--ctrl-clear);
  --icon-hover-bg: var(--ctrl-clear-hover);
  display: none;
  opacity: 0;
  margin-right: -0.5em;
}
WUP-TEXTRICH button[clear=back] {
  --icon-img: var(--wup-icon-back);
}
WUP-TEXTRICH:focus-within button[clear] {
  display: inline-block;
  opacity: 1;
}
@media (hover: hover) and (pointer: fine) {
  WUP-TEXTRICH:hover button[clear] {
    display: inline-block;
    opacity: 1;
  }
}
WUP-TEXTRICH[disabled] button[clear], WUP-TEXTRICH[readonly] button[clear] {
  display: none;
  pointer-events: none;
}
WUP-TEXTRICH strong {
  top: 1.6em;
}
WUP-TEXTRICH [contenteditable=true] {
  min-height: 4em;
  max-height: 4em;
}
WUP-TEXTRICH {
  position: relative;
  display: flex;
  flex-direction: column;
}
WUP-TEXTRICH &gt; label {
  --ctrl-label-active-pos: translateY(-50%) scale(0.9);
}
WUP-TEXTRICH &gt; label &gt; span {
  position: static;
}
WUP-TEXTRICH &gt; label strong {
  top: 0;
  left: calc(var(--ctrl-icon-size) - 0.25em);
  max-width: calc(100% - 2 * var(--ctrl-icon-size));
  padding: 0 0.25em;
  transform-origin: center left;
  transform: var(--ctrl-label-active-pos);
  color: var(--ctrl-focus-label);
  background: var(--ctrl-textrich-label-bg, var(--ctrl-bg));
  border-radius: 0.5em;
}
WUP-TEXTRICH [role=toolbar] {
  order: -1;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: flex-end;
  gap: 0 0.75em;
  padding: 0.25em 0.5em;
  border-bottom: 1px solid var(--ctrl-border);
  cursor: default;
}
WUP-TEXTRICH [role=toolbar]:empty {
  display: none;
}
WUP-TEXTRICH [role=group] {
  display: flex;
  align-items: center;
}
WUP-TEXTRICH [role=group] &gt; button {
  --icon: var(--ctrl-icon);
  --icon-size: 1.125em;
  --icon-hover: var(--ctrl-selected);
  --icon-hover-bg: none;
  --icon-hover-r: 1.75em;
  display: inline-block;
  cursor: pointer;
  box-shadow: none;
  border: none;
  margin: 0;
  padding: 0;
  width: var(--icon-hover-r, 2em);
  height: var(--icon-hover-r, 2em);
  background: none;
  outline: none;
  border-radius: 50%;
  border-radius: 4px;
}
WUP-TEXTRICH [role=group] &gt; button:after {
  content: "";
  display: inline-block;
