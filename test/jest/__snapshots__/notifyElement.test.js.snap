[wupdark] {
  --notify-text: #d8d8d8;
  --notify-shadow: #0006;
}
  
WUP-NOTIFY {
  --modal-anim: var(--modal-anim-t) cubic-bezier(0, 0, 0.2, 1) 0ms;
  z-index: 8000;
  display: none;
  opacity: 0;
  position: fixed !important;
  border-radius: var(--border-radius);
  padding: var(--base-margin);
  box-sizing: border-box;
  white-space: pre-line;
  overflow: auto;
  overflow: overlay;
}
WUP-NOTIFY[open] {
  display: block;
}
WUP-NOTIFY[show] {
  opacity: 1;
}
WUP-NOTIFY::-webkit-scrollbar {
  width: 10px;
  height: 10px;
  cursor: pointer;
}
WUP-NOTIFY::-webkit-scrollbar-corner {
  background: none;
  cursor: pointer;
}
WUP-NOTIFY::-webkit-scrollbar-thumb {
  border: 3px solid rgba(0, 0, 0, 0);
  background-clip: padding-box;
  background-color: var(--scroll, rgba(0, 0, 0, 0.2));
  border-radius: 999px;
  cursor: pointer;
}
@media (hover: hover) {
WUP-NOTIFY::-webkit-scrollbar-thumb:hover {
  background-color: var(--scroll-hover, rgba(0, 0, 0, 0.5));
  cursor: pointer;
}
}
WUP-NOTIFY::-webkit-scrollbar-track-piece:vertical:start, WUP-NOTIFY::-webkit-scrollbar-track-piece:vertical:end, WUP-NOTIFY::-webkit-scrollbar-track-piece:horizontal:start, WUP-NOTIFY::-webkit-scrollbar-track-piece:horizontal:end {
  margin: 0;
  cursor: pointer;
}
@media not all and (prefers-reduced-motion) {
  WUP-NOTIFY {
    transition: opacity var(--modal-anim), transform var(--modal-anim);
  }
}
WUP-NOTIFY {
  --modal-anim: var(--notify-anim-t) cubic-bezier(0, 0, 0.2, 1) 0ms;
  z-index: 9010;
  min-height: 64px;
  max-height: 80vh;
  align-content: safe center;
  width: var(--notify-w);
  max-width: 80vw;
  margin: var(--notify-margin);
  color: var(--notify-text);
  background: var(--notify-bg);
  box-shadow: 0 1px 4px 0 var(--notify-shadow);
}
WUP-NOTIFY[w-placement$=-left] {
  border-radius: 0 var(--border-radius) var(--border-radius) 0;
  left: 0;
  transform: translateX(-100%);
}
WUP-NOTIFY[w-placement$=-right] {
  border-radius: var(--border-radius) 0 0 var(--border-radius);
  right: 0;
  transform: translateX(100%);
}
WUP-NOTIFY[w-placement$=-middle] {
  margin-left: auto;
  margin-right: auto;
  left: 0;
  right: 0;
  transform: translateY(-100%);
}
WUP-NOTIFY[w-placement^=top-] {
  top: 0;
}
WUP-NOTIFY[w-placement^=bottom-] {
  bottom: 0;
}
WUP-NOTIFY[show] {
  transform: none;
}
@media not all and (prefers-reduced-motion) {
  WUP-NOTIFY[show] {
    transition: opacity var(--modal-anim), transform var(--modal-anim), translate var(--modal-anim);
  }
}
WUP-NOTIFY[swiping] {
  transition: none;
  will-change: transform, opacity;
}
WUP-NOTIFY &gt; button[close] {
  --icon-img: var(--wup-icon-cross);
  --icon: var(--notify-text);
  z-index: 10;
  position: absolute;
  right: 0;
  top: 0;
  margin: 0.4em;
}
WUP-NOTIFY &gt; [progress] {
  position: sticky;
  top: 100%;
  bottom: 0;
  height: 0;
  margin: 0 calc(-1 * var(--base-margin));
  transform-origin: left;
}
WUP-NOTIFY &gt; [progress]:after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  top: calc(var(--base-margin) - 5px);
  height: 5px;
  background: var(--notify-progress);
}
WUP-NOTIFY[w-placement$=-right] &gt; [progress] {
  transform-origin: right;
}
WUP-NOTIFY[w-type=info] {
  --notify-type: var(--notify-info);
  --notify-type-img: var(--wup-icon-info);
  --notify-bg: var(--notify-info-bg);
  --notify-text: var(--notify-info-text);
}
WUP-NOTIFY[w-type=success] {
  --notify-type: var(--notify-success);
  --notify-type-img: var(--wup-icon-success);
  --notify-bg: var(--notify-success-bg);
  --notify-text: var(--notify-success-text);
}
WUP-NOTIFY[w-type=warning] {
  --notify-type: var(--notify-warning);
  --notify-type-img: var(--wup-icon-warning);
  --notify-bg: var(--notify-warning-bg);
  --notify-text: var(--notify-warning-text);
}
WUP-NOTIFY[w-type=error] {
  --notify-type: var(--notify-error);
  --notify-type-img: var(--wup-icon-error);
  --notify-bg: var(--notify-error-bg);
  --notify-text: var(--notify-error-text);
}
WUP-NOTIFY[w-type] {
  --notify-progress: var(--notify-type);
  --notify-pl: calc(1.5 * var(--base-margin) + var(--notify-icon-size));
  padding-left: var(--notify-pl);
}
WUP-NOTIFY[w-type]:before {
  content: "";
  position: absolute;
  top: 0;
  bottom: 0;
  left: var(--base-margin);
  width: var(--notify-icon-size);
  background: var(--notify-type);
  -webkit-mask-image: var(--notify-type-img);
          mask-image: var(--notify-type-img);
  -webkit-mask-size: var(--notify-icon-size);
          mask-size: var(--notify-icon-size);
  -webkit-mask-repeat: no-repeat;
          mask-repeat: no-repeat;
  -webkit-mask-position: center;
          mask-position: center;
}
WUP-NOTIFY[w-type] &gt; [progress] {
  margin-left: calc(-1 * var(--notify-pl));
}
</style>
`;

